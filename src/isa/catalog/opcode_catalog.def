/* P3-S6 PORTR PA,Smem (TI SPRU172C 4-129): word 0 pins 0x74 with the I
 * flag at bit 7 and the 7-bit Smem cookie at bits 6:0 (direct dma
 * offset when I=0, ARF at bits 2:0 with the 4-bit MOD at bits 6:3
 * when I=1); word 1 carries the absolute 16-bit I/O port address.
 * Long-offset and absolute Smem extension words stay undecoded. */
TI_C54X_OPCODE_MASKED(PORTR_DIRECT, portr_direct, 0x7400, 0xFF80, 2, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7_PA16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_STATUS_DP)
TI_C54X_OPCODE_MASKED(PORTR_SMEM, portr_smem, 0x7480, 0xFF80, 2, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7_PA16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_AUXILIARY_REGISTERS)
/* P3-S6 PORTW Smem,PA (TI SPRU172C 4-130): word 0 pins 0x75 with the I
 * flag at bit 7 and the 7-bit Smem cookie at bits 6:0 (direct dma
 * offset when I=0, ARF at bits 2:0 with the 4-bit MOD at bits 6:3
 * when I=1); word 1 carries the absolute 16-bit I/O port address.
 * Long-offset and absolute Smem extension words stay undecoded. */
