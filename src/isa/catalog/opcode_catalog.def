 * op_mpy_lk core. TI pins no R bit in this space, so the
 * unrounded leaf covers it fully. */
TI_C54X_OPCODE_MASKED(MPY_LK, mpy_lk, 0xF066, 0xFEFF, 2, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_IMMEDIATE_LK16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_T_REGISTER_STATUS_FRCT_OVM)
TI_C54X_OPCODE_MASKED(MPYA_SMEM, mpya_smem, 0x3100, 0xFF00, 1, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_ELIGIBLE, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_FRCT_OVM)
TI_C54X_OPCODE_MASKED(MAS_SMEM, mas_smem, 0x2C00, 0xFC00, 1, TI_C54X_OPERAND_LAYOUT_ROUND_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_ELIGIBLE, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_T_REGISTER_STATUS_FRCT_OVM)
/* Unsigned multiply of preset T by Smem into the D-selected
