/*
 * Module contract
 *
 * Owns: the sole declarative first-word opcode inventory for the standalone
 * TI C54x core. The source schema supports EXACT, MASKED, and MASKED2
 * (second-word-qualified) rows; this
 * production inventory contains the exact NOP row plus masked status-load,
 * status-bit set/clear, standard-indirect memory load/store (including the
 * CMPT=0 reverse-carry MOD4/MOD7, AR0-indexed MOD5/MOD6, and circular
 * MOD8/MOD10 family rows), compare,
 * complement, exponent,
 * rotate, shift, and one- or two-word logical-accumulator rows.
 * The P3-S6 PORTR direct/indirect rows use the two-word
 * indirect-plus-port-address layout.
 * The W47B2 DLD/DST long32 MOD13 rows use the four-field two-word layout.
 * The W46B neutral ANDM/ORM/XORM rows reuse the generic two-word
 * ARF-extension standard-indirect shape across MOD0 through MOD3, as does
 * the ADDM row at the next first-word slot (with OVM/SXM modes and an ADD
 * transform instead of a logical one).
 * Every consumer derives its own view from this same file.
 * Does not own: opcode strings, timing, bus/state behavior, or a second
 * handwritten instruction table. The handler token is an operation binding
 * token owned by the ISA operations module.
 */

TI_C54X_OPCODE_EXACT(NOP, nop, 0xF495, 1, TI_C54X_OPERAND_LAYOUT_NONE, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_NONE)
TI_C54X_OPCODE_MASKED(SSBX_STATUS, ssbx_status, 0xF5B0, 0xFDF0, 1, TI_C54X_OPERAND_LAYOUT_STATUS_BIT, TI_C54X_REPEATABILITY_INELIGIBLE, TI_C54X_INPUT_RESOURCES_NONE)
TI_C54X_OPCODE_MASKED(RSBX_STATUS, rsbx_status, 0xF4B0, 0xFDF0, 1, TI_C54X_OPERAND_LAYOUT_STATUS_BIT, TI_C54X_REPEATABILITY_INELIGIBLE, TI_C54X_INPUT_RESOURCES_NONE)
TI_C54X_OPCODE_MASKED(LD_IMMEDIATE_DP, ld_immediate_dp, 0xEA00, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_LD_IMMEDIATE_DP, TI_C54X_REPEATABILITY_INELIGIBLE, TI_C54X_INPUT_RESOURCES_NONE)
TI_C54X_OPCODE_MASKED(LD_IMMEDIATE_ASM, ld_immediate_asm, 0xED00, 0xFFE0, 1, TI_C54X_OPERAND_LAYOUT_LD_IMMEDIATE_ASM, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_NONE)
TI_C54X_OPCODE_MASKED(LD_IMMEDIATE_ARP, ld_immediate_arp, 0xF4A0, 0xFFF8, 1, TI_C54X_OPERAND_LAYOUT_LD_IMMEDIATE_ARP, TI_C54X_REPEATABILITY_INELIGIBLE, TI_C54X_INPUT_RESOURCES_NONE)
TI_C54X_OPCODE_MASKED(LD_SMEM, ld_smem, 0x1080, 0xFEE0, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_ARF_MOD, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_STATUS_SXM)
TI_C54X_OPCODE_MASKED(LD_SMEM_TS, ld_smem_ts, 0x1480, 0xFEE0, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_ARF_MOD, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_STATUS_SXM_T_REGISTER)
TI_C54X_OPCODE_MASKED(STL_SMEM, stl_smem, 0x8080, 0xFEE0, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_ARF_MOD, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(STH_SMEM, sth_smem, 0x8280, 0xFEE0, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_ARF_MOD, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(STH_ASM_SMEM, sth_asm_smem, 0x8680, 0xFEE0, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_ARF_MOD, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_ASM)
TI_C54X_OPCODE_MASKED(MAX_ACC, max_acc, 0xF486, 0xFEFF, 1, TI_C54X_OPERAND_LAYOUT_MAX_MIN_ACC, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(MIN_ACC, min_acc, 0xF487, 0xFEFF, 1, TI_C54X_OPERAND_LAYOUT_MAX_MIN_ACC, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(EXP_ACC, exp_acc, 0xF48E, 0xFEFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(CMPL_ACC, cmpl_acc, 0xF493, 0xFCFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(ROL_ACC, rol_acc, 0xF491, 0xFEFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_C)
TI_C54X_OPCODE_MASKED(ROR_ACC, ror_acc, 0xF490, 0xFEFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_C)
TI_C54X_OPCODE_MASKED(ROLTC_ACC, roltc_acc, 0xF492, 0xFEFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_TC)
TI_C54X_OPCODE_MASKED(SFTC_ACC, sftc_acc, 0xF494, 0xFEFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(SFTL_ACC, sftl_acc, 0xF0E0, 0xFCE0, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_SHIFT5, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
/* SFTA src,SHIFT[,dst]: arithmetic shift with S/D riding bits 9:8
 * and the signed SHIFT riding bits 4:0 through the shared
 * accumulator source/destination/shift5 layout. */
TI_C54X_OPCODE_MASKED(SFTA_ACC, sfta_acc, 0xF460, 0xFCE0, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_SHIFT5, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_OVM)
TI_C54X_OPCODE_MASKED(AND_ACC_SHIFT, and_acc_shift, 0xF080, 0xFCE0, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_SHIFT5, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(OR_ACC_SHIFT, or_acc_shift, 0xF0A0, 0xFCE0, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_SHIFT5, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(XOR_ACC_SHIFT, xor_acc_shift, 0xF0C0, 0xFCE0, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_SHIFT5, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
/* Syntax-1 ADD Smem: src += Smem with S riding bit 8 through the
 * shared select/indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(ADD_SMEM, add_smem, 0x0000, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_OVM)
/* Syntax-2 ADD Smem<<TS: src += Smem shifted by the T register with
 * S riding bit 8 through the shared select/indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(ADD_SMEM_TS, add_smem_ts, 0x0400, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_T_REGISTER_STATUS_SXM_OVM)
/* Syntax-3 ADD Smem<<16: dst = src + (Smem << 16) with S/D riding
 * bits 9/8 through the shared source/destination/indirect/addr7
 * layout. */
TI_C54X_OPCODE_MASKED(ADD_SMEM_SH16, add_smem_sh16, 0x3C00, 0xFC00, 1, TI_C54X_OPERAND_LAYOUT_SOURCE_DESTINATION_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_OVM)
/* Syntax-1 SUB Smem: src -= Smem with S riding bit 8 through the
 * shared select/indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(SUB_SMEM, sub_smem, 0x0800, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_OVM)
/* Syntax-2 SUB Smem<<TS: src -= Smem shifted by the T register with
 * S riding bit 8 through the shared select/indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(SUB_SMEM_TS, sub_smem_ts, 0x0C00, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_T_REGISTER_STATUS_SXM_OVM)
/* Syntax-3 SUB Smem<<16: dst = src - (Smem << 16) with S/D riding
 * bits 9/8 through the shared source/destination/indirect/addr7
 * layout. */
TI_C54X_OPCODE_MASKED(SUB_SMEM_SH16, sub_smem_sh16, 0x4000, 0xFC00, 1, TI_C54X_OPERAND_LAYOUT_SOURCE_DESTINATION_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_OVM)
/* DADD Lmem: dst = Lmem + src (C16=0, 40-bit) or dual 16-bit adds
 * (C16=1) with S/D riding bits 9/8 through the shared
 * source/destination/indirect/addr7 layout. Zero neighbor moves:
 * 0x5000-0x53FF decode UNKNOWN today. */
TI_C54X_OPCODE_MASKED(DADD, dadd, 0x5000, 0xFC00, 1, TI_C54X_OPERAND_LAYOUT_SOURCE_DESTINATION_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_OVM_C16)
/* Syntax-1 AND Smem: dst &= Smem with S riding bit 8 through the
 * shared select/indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(AND_SMEM, and_smem, 0x1800, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
/* Syntax-1 OR Smem: dst |= Smem with S riding bit 8 through the
 * shared select/indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(OR_SMEM, or_smem, 0x1A00, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
/* Syntax-1 XOR Smem: dst ^= Smem with S riding bit 8 through the
 * shared select/indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(XOR_SMEM, xor_smem, 0x1C00, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
/* SUBB Smem: dst = src - Smem - ~C with D riding bit 8 through the
 * shared select/indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(SUBB_SMEM, subb_smem, 0x0E00, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_C_OVM)
/* SUBS Smem: dst = src - unsigned(Smem) with S riding bit 8 through
 * the shared select/indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(SUBS_SMEM, subs_smem, 0x0A00, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_OVM)
/* ADDC Smem: dst = src + Smem + C with D riding bit 8 through the
 * shared select/indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(ADDC_SMEM, addc_smem, 0x0600, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_C_OVM)
/* ADDS Smem: dst = src + unsigned(Smem) with saturation riding bit 8
 * through the shared select/indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(ADDS_SMEM, adds_smem, 0x0200, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_OVM)
/* SUBC Smem: conditional subtract stepping bit 8 through the shared
 * select/indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(SUBC_SMEM, subc_smem, 0x1E00, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM)
TI_C54X_OPCODE_MASKED(ADD_ACC_SHIFT, add_acc_shift, 0xF400, 0xFCE0, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_SHIFT5, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_OVM)
TI_C54X_OPCODE_MASKED(SUB_ACC_SHIFT, sub_acc_shift, 0xF420, 0xFCE0, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_SHIFT5, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_OVM)
TI_C54X_OPCODE_MASKED(AND_IMMEDIATE_SHIFT, and_immediate_shift, 0xF030, 0xFCF0, 2, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_SHIFT4_EXTENSION16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(AND_IMMEDIATE_SHIFT16, and_immediate_shift16, 0xF063, 0xFCFF, 2, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_EXTENSION16_SHIFT16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(OR_IMMEDIATE_SHIFT, or_immediate_shift, 0xF040, 0xFCF0, 2, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_SHIFT4_EXTENSION16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(OR_IMMEDIATE_SHIFT16, or_immediate_shift16, 0xF064, 0xFCFF, 2, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_EXTENSION16_SHIFT16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(XOR_IMMEDIATE_SHIFT, xor_immediate_shift, 0xF050, 0xFCF0, 2, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_SHIFT4_EXTENSION16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(XOR_IMMEDIATE_SHIFT16, xor_immediate_shift16, 0xF065, 0xFCFF, 2, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_EXTENSION16_SHIFT16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
/* ADD #lk syntaxes 7-8: lk<<SHFT (syn7) and lk<<16 (syn8) over the
 * shared 2-word accumulator layouts into the landed op_add_lk core. */
TI_C54X_OPCODE_MASKED(ADD_LK_SHIFT, add_lk_shift, 0xF000, 0xFCF0, 2, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_SHIFT4_EXTENSION16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_OVM)
TI_C54X_OPCODE_MASKED(ADD_LK_16, add_lk_16, 0xF060, 0xFCFF, 2, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_EXTENSION16_SHIFT16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_OVM)
/* SUB #lk syntaxes 7-8: src minus lk<<SHFT (syn7) and lk<<16 (syn8)
 * over the shared 2-word accumulator layouts into the landed
 * op_sub_lk core. */
TI_C54X_OPCODE_MASKED(SUB_LK_SHIFT, sub_lk_shift, 0xF010, 0xFCF0, 2, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_SHIFT4_EXTENSION16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_OVM)
TI_C54X_OPCODE_MASKED(SUB_LK_16, sub_lk_16, 0xF061, 0xFCFF, 2, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_EXTENSION16_SHIFT16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_OVM)
/* ADD Xmem (syntax 5): dst accumulates the dual-indirect Xmem operand
 * shifted by SHFT across all four XMOD modes through the shared
 * accumulator/dual-XMOD/XAR/shift-4 layout into the landed op_add_xmem
 * core. */
TI_C54X_OPCODE_MASKED(ADD_XMEM, add_xmem, 0x9000, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_DUAL_XMOD_XAR_SHIFT4, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_AUXILIARY_REGISTERS_STATUS_SXM_OVM)
/* SUB Xmem (syntax 5): dst subtracts the dual-indirect Xmem operand
 * shifted by SHFT across all four XMOD modes through the shared
 * accumulator/dual-XMOD/XAR/shift-4 layout into the landed op_sub_xmem
 * core. */
TI_C54X_OPCODE_MASKED(SUB_XMEM, sub_xmem, 0x9200, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_DUAL_XMOD_XAR_SHIFT4, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_AUXILIARY_REGISTERS_STATUS_SXM_OVM)
/* ADD src,ASM (syntax 10): dst accumulates src shifted by ASM over
 * the shared accumulator source/destination layout into the landed
 * op_add_src_asm core. */
TI_C54X_OPCODE_MASKED(ADD_SRC_ASM, add_src_asm, 0xF480, 0xFCFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_OVM_ASM)
/* SUB src,ASM (syntax 10): dst subtracts src shifted by ASM over
 * the shared accumulator source/destination layout into the landed
 * op_sub_src_asm core. */
TI_C54X_OPCODE_MASKED(SUB_SRC_ASM, sub_src_asm, 0xF481, 0xFCFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_OVM_ASM)
TI_C54X_OPCODE_MASKED(CMPR_AR, cmpr, 0xF4A8, 0xFCF8, 1, TI_C54X_OPERAND_LAYOUT_CONDITION_ARF, TI_C54X_REPEATABILITY_INELIGIBLE, TI_C54X_INPUT_RESOURCES_AUXILIARY_REGISTERS)
TI_C54X_OPCODE_MASKED(LDU_SMEM, ldu_smem, 0x1280, 0xFEE0, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_ARF_MOD, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_NONE)
TI_C54X_OPCODE_MASKED(LD_T_SMEM, ld_t_smem, 0x3080, 0xFFE0, 1, TI_C54X_OPERAND_LAYOUT_ARF_MOD, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_NONE)
/* LTD Smem: T = Smem with the Smem delay write-back of the Smem
 * word to DATA Smem+1. I rides bit 7 and the address rides bits
 * 6:0 through the shared indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(LTD_SMEM, ltd_smem, 0x4C00, 0xFF00, 1, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_NONE)
/* DELAY Smem: the Smem delay write-back of the Smem word to DATA
 * Smem+1 with no register or status effects. I rides bit 7 and the
 * address rides bits 6:0 through the shared indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(DELAY_SMEM, delay_smem, 0x4D00, 0xFF00, 1, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_NONE)
TI_C54X_OPCODE_MASKED(ST_IMMEDIATE_SMEM, st_immediate_smem, 0x7680, 0xFFE0, 2, TI_C54X_OPERAND_LAYOUT_ARF_EXTENSION16_MOD, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_NONE)
TI_C54X_OPCODE_MASKED(LD_DP_SMEM, ld_dp_smem, 0x4680, 0xFFE0, 1, TI_C54X_OPERAND_LAYOUT_ARF_MOD, TI_C54X_REPEATABILITY_INELIGIBLE, TI_C54X_INPUT_RESOURCES_NONE)
TI_C54X_OPCODE_MASKED(LD_ASM_SMEM, ld_asm_smem, 0x3280, 0xFFE0, 1, TI_C54X_OPERAND_LAYOUT_ARF_MOD, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_NONE)
TI_C54X_OPCODE_MASKED(LD_SMEM_SHIFT16, ld_smem_shift16, 0x4480, 0xFEE0, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_ARF_MOD, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_STATUS_SXM)
TI_C54X_OPCODE_MASKED(ST_T_SMEM, st_t_smem, 0x8C80, 0xFFE0, 1, TI_C54X_OPERAND_LAYOUT_ARF_MOD, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_T_REGISTER)
/* ST T,Smem (syntax 1, direct only): T stages into page-0 Smem
 * over the 0x8C00 first word with the I bit fixed zero (mask
 * 0xFF80, 128 encodings) through the shared indirect/addr7
 * layout into the landed op_st_t_smem_direct core. Indirect
 * composes through the established ST_T MOD rows above, which
 * start at 0x8C80. */
TI_C54X_OPCODE_MASKED(ST_T_SMEM_DIRECT, st_t_smem_direct, 0x8C00, 0xFF80, 1, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_T_REGISTER)
/* ST TRN,Smem (syntax 2, direct only): TRN stages into page-0 Smem
 * over the 0x8D00 first word with the I bit fixed zero (mask
 * 0xFF80, 128 encodings) through the shared indirect/addr7
 * layout into the landed op_st_trn_smem_direct core. No ST_TRN
 * MOD rows exist yet, so the I-set half rejects in the leaf. */
TI_C54X_OPCODE_MASKED(ST_TRN_SMEM_DIRECT, st_trn_smem_direct, 0x8D00, 0xFF80, 1, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_TRN_REGISTER)
/* CMPS src,Smem (direct only): the signed 16-bit maximum of
 * src(31:16) and src(15:0) stages into page-0 Smem over the
 * 0x8E00 first word with S free and the I bit fixed zero (mask
 * 0xFE80, 256 encodings) through the shared
 * select/indirect/addr7 layout into the landed
 * op_cmps_smem_direct core. The completion stages the
 * TRN_SHIFT_WRITE follow-on. No CMPS MOD rows exist yet, so
 * the I-set half rejects in the leaf. */
TI_C54X_OPCODE_MASKED(CMPS_SMEM_DIRECT, cmps_smem_direct, 0x8E00, 0xFE80, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_TRN_REGISTER)
/* STL src,Smem (syntax 1, direct only): accumulator low stages into
 * page-0 Smem over the 0x8000 first word with S free and the I bit
 * fixed zero (mask 0xFE80, 256 encodings) through the shared
 * select/indirect/addr7 layout into the landed op_stl_smem_direct
 * core. No STL MOD rows exist yet, so the I-set half rejects in
 * the leaf. */
TI_C54X_OPCODE_MASKED(STL_SMEM_DIRECT, stl_smem_direct, 0x8000, 0xFE80, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
/* STL src,ASM,Smem (syntax 2, direct only): ASM-shifted accumulator
 * low stages into page-0 Smem over the 0x8400 first word with S free
 * and the I bit fixed zero (mask 0xFE80, 256 encodings) through the
 * shared select/indirect/addr7 layout into the landed
 * op_stl_asm_smem_direct core. */
TI_C54X_OPCODE_MASKED(STL_ASM_SMEM_DIRECT, stl_asm_smem_direct, 0x8400, 0xFE80, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_SXM_ASM)
/* STLM src,MMR (direct only): accumulator low stages into page-0
 * MMR over the 0x8800 first word with S free and the I bit fixed
 * zero (mask 0xFE80, 256 encodings) through the shared
 * select/indirect/addr7 layout into the landed
 * op_stlm_smem_direct core. MMR-register routing is downstream;
 * the I-set half rejects in the leaf. */
TI_C54X_OPCODE_MASKED(STLM_SMEM_DIRECT, stlm_smem_direct, 0x8800, 0xFE80, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
/* LDM MMR,dst (direct only): page-0 MMR stages into dst(15:0)
 * with dst(39:16) cleared over the 0x4800 first word with D free
 * and the I bit fixed zero (mask 0xFE80, 256 encodings) through
 * the shared select/indirect/addr7 layout into the landed
 * op_ldm_smem_direct core with a zero-extending completion. */
TI_C54X_OPCODE_MASKED(LDM_SMEM_DIRECT, ldm_smem_direct, 0x4800, 0xFE80, 1, TI_C54X_OPERAND_LAYOUT_SELECT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_NONE)
/* BITF Smem,#lk: TC stages ((Smem & lk) != 0) over the 0x6100
 * first word with the copied lk extension through the shared
 * Smem,#lk layout into the landed op_bitf_smem_lk core. Table
 * 6-18 omits every BIT form, so the row is repeatable. */
TI_C54X_OPCODE_MASKED(BITF_SMEM_LK, bitf_smem_lk, 0x6100, 0xFF00, 2, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7_EXTENSION16, TI_C54X_REPEATABILITY_ELIGIBLE, TI_C54X_INPUT_RESOURCES_NONE)
/* CMPM Smem,#lk: TC stages (Smem == lk) over the 0x6000 first
 * word with the copied lk extension through the shared
 * Smem,#lk layout into the landed op_cmpm_smem_lk core. Table
 * 6-18 omits CMPM, so the row is repeatable. */
TI_C54X_OPCODE_MASKED(CMPM_SMEM_LK, cmpm_smem_lk, 0x6000, 0xFF00, 2, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7_EXTENSION16, TI_C54X_REPEATABILITY_ELIGIBLE, TI_C54X_INPUT_RESOURCES_NONE)
/* BITT Smem: TC stages Smem(15 - T(3:0)) over the 0x3400 first
 * word through the shared indirect-addr7 layout into the landed
 * op_bitt_smem core. Table 6-18 omits BITT, so the row is
 * repeatable. */
TI_C54X_OPCODE_MASKED(BITT_SMEM, bitt_smem, 0x3400, 0xFF00, 1, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_ELIGIBLE, TI_C54X_INPUT_RESOURCES_T_REGISTER)
/* ST #lk,Smem (syntax 3, direct only): lk stages into page-0
 * Smem over the 0x7600 first word with the copied lk extension
