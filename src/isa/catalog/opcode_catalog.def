TI_C54X_OPCODE_MASKED(CMPR_AR, cmpr, 0xF4A8, 0xFCF8, 1, TI_C54X_OPERAND_LAYOUT_CONDITION_ARF, TI_C54X_REPEATABILITY_INELIGIBLE, TI_C54X_INPUT_RESOURCES_AUXILIARY_REGISTERS)
TI_C54X_OPCODE_MASKED(LDU_SMEM_MOD2, ldu_smem, 0x1290, 0xFEF8, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_ARF, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_NONE)
TI_C54X_OPCODE_MASKED(LD_T_SMEM_MOD2, ld_t_smem, 0x3090, 0xFFF8, 1, TI_C54X_OPERAND_LAYOUT_ARF, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_NONE)
TI_C54X_OPCODE_MASKED(ST_IMMEDIATE_SMEM_MOD2, st_immediate_smem, 0x7690, 0xFFF8, 2, TI_C54X_OPERAND_LAYOUT_ARF_EXTENSION16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_NONE)
