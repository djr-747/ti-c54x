 * over the 0xF067|S<<9|D<<8 base plus lk extension word into the
 * landed op_mac_lk core. TI pins no R bit in this space, so the
 * unrounded leaf covers it fully. */
TI_C54X_OPCODE_MASKED(MAC_LK, mac_lk, 0xF067, 0xFCFF, 2, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION_EXTENSION16_SHIFT16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_T_REGISTER_STATUS_FRCT_OVM)
