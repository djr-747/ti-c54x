 * read-phase T load. R/I/addr7 ride the word through the round/
 * indirect/addr7 layout; the R bit carries the MACAR variant. */
TI_C54X_OPCODE_MASKED(MACA_SMEM, maca_smem, 0x3500, 0xFD00, 1, TI_C54X_OPERAND_LAYOUT_ROUND_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_ELIGIBLE, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_T_REGISTER_STATUS_FRCT_OVM)
/* Syntax-1 one-word square of Smem into the D-selected accumulator with
 * read-phase T load. D/I/addr7 ride the word through the dedicated
 * destination/indirect/addr7 layout. */
TI_C54X_OPCODE_MASKED(SQUR_SMEM, squr_smem, 0x2600, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_DESTINATION_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_ELIGIBLE, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_T_REGISTER_STATUS_FRCT_OVM)
/* Syntax-2 register-only square of A-high into the D-selected
 * accumulator. The single row carries both encodings; D rides the
 * word through the reused MAX/MIN single-destination-bit layout. */
TI_C54X_OPCODE_MASKED(SQUR_ADST, squr_adst, 0xF48D, 0xFEFF, 1, TI_C54X_OPERAND_LAYOUT_MAX_MIN_ACC, TI_C54X_REPEATABILITY_ELIGIBLE, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_FRCT_OVM)
/* Accumulate squares: SQURA adds Smem x Smem into src, SQURS
 * subtracts it. Both share the destination/indirect/addr7 layout
 * and one leaf file with an ADD/SUBTRACT select. */
TI_C54X_OPCODE_MASKED(SQURA_SMEM, squra_smem, 0x3800, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_DESTINATION_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_ELIGIBLE, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_T_REGISTER_STATUS_FRCT_OVM)
TI_C54X_OPCODE_MASKED(SQURS_SMEM, squrs_smem, 0x3A00, 0xFE00, 1, TI_C54X_OPERAND_LAYOUT_DESTINATION_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_ELIGIBLE, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_T_REGISTER_STATUS_FRCT_OVM)
/* Syntax-2 register-only MPYA across the D destination select. The single
 * row carries both encodings; D rides the word through the reused
 * MAX/MIN single-destination-bit layout. */
TI_C54X_OPCODE_MASKED(MPYA_DST, mpya_dst, 0xF48C, 0xFEFF, 1, TI_C54X_OPERAND_LAYOUT_MAX_MIN_ACC, TI_C54X_REPEATABILITY_ELIGIBLE, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_T_REGISTER_STATUS_FRCT_OVM)
/* Syntax-2 register-only MACA across the S source, D destination, and R
 * round selects. The single row carries all 8 encodings (the R bit carries
 * the MACAR T,src variant); S/D/R ride the word through the new
 * source/destination/round layout. Low bytes 0x88/0x89 keep the row
 * disjoint from the neighboring MPYA_DST row. */
TI_C54X_OPCODE_MASKED(MACA_T, maca_t, 0xF488, 0xFCFE, 1, TI_C54X_OPERAND_LAYOUT_SOURCE_DESTINATION_ROUND, TI_C54X_REPEATABILITY_ELIGIBLE, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_T_REGISTER_STATUS_FRCT_OVM)
/* Syntax-1 subtract of Smem times A-high from fixed B with
 * read-phase T load. I/addr7 ride the word through the shared
 * indirect/addr7 layout; dst is fixed B and there is no R bit
 * (the MASAR Smem variant shares no row). */
TI_C54X_OPCODE_MASKED(MASA_SMEM, masa_smem, 0x3300, 0xFF00, 1, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_T_REGISTER_STATUS_FRCT_OVM)
/* Syntax-2 register-only MASA across the S source, D destination, and R
 * round selects. The single row carries all 8 encodings (the R bit carries
 * the MASAR T,src variant); S/D/R ride the word through the shared
 * source/destination/round layout. Low bytes 0x8A/0x8B keep the row
 * disjoint from the neighboring MACA_T row. */
TI_C54X_OPCODE_MASKED(MASA_T, masa_t, 0xF48A, 0xFCFE, 1, TI_C54X_OPERAND_LAYOUT_SOURCE_DESTINATION_ROUND, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_T_REGISTER_STATUS_FRCT_OVM)
/* RND src[,dst]: dst40 = src40 + 8000h with 40-bit wrap over the
 * 0xF49F|S<<9|D<<8 single word through the shared
 * accumulator/source/destination layout. OVM gates saturation of a
 * signed-32 overflowing result with sticky OVdst; TI section RND
 * (p. 4-142) marks the form not repeatable. */
TI_C54X_OPCODE_MASKED(RND_ACC, rnd_acc, 0xF49F, 0xFCFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION, TI_C54X_REPEATABILITY_INELIGIBLE, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_OVM)
/* SAT src: saturate src40 to signed 32 bits written back to src over
 * the 0xF483|S<<8 single word through the shared
 * accumulator/source layout. Saturation applies regardless of OVM
 * with OVsrc recomputed (set on clamp, cleared otherwise) per the
 * TI SAT examples (p. 4-154). Neither Table 2-28 nor Table 6-18
 * lists SAT, but omission never implies eligibility, so the row
 * stays UNRESOLVED like its MAX/MIN/EXP/CMPL accumulator-unary
 * neighbors. */
TI_C54X_OPCODE_MASKED(SAT_ACC, sat_acc, 0xF483, 0xFEFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
/* ABS src[,dst]: dst40 = |src40| over the 0xF485|S<<9|D<<8 single
 * word through the shared accumulator/source/destination layout.
 * OVM gates the 80_0000_0000h edge (00_7FFF_FFFFh vs hold) with
 * sticky OVdst; C is set iff the result is zero, per the TI ABS
 * examples (p. 4-3). Neither Table 2-28 nor Table 6-18 lists ABS,
 * but omission never implies eligibility, so the row stays
 * UNRESOLVED like its SAT accumulator-unary neighbor. */
TI_C54X_OPCODE_MASKED(ABS_ACC, abs_acc, 0xF485, 0xFCFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_OVM)
/* NEG src[,dst]: dst40 = -src40 over the 0xF484|S<<9|D<<8 single
 * word through the shared accumulator/source/destination layout.
 * C is cleared for nonzero src and set for zero src; signed-32
 * overflowing results saturate (OVM=1) or hold (OVM=0) with
 * sticky OVdst, per the TI NEG prose and examples
 * (pp. 4-119--4-120). Neither Table 2-28 nor Table 6-18 lists
 * NEG, so the row stays UNRESOLVED like ABS above. */
TI_C54X_OPCODE_MASKED(NEG_ACC, neg_acc, 0xF484, 0xFCFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_STATUS_OVM)
/* NORM src[,dst]: dst40 = src40 << TS over the 0xF48F|S<<9|D<<8
 * single word through the shared accumulator/source/destination
 * layout. The shift count is T(5:0) as a 2s-complement value
 * (-16..31); SXM rules right shifts and OVM saturates left-shift
 * overflow with sticky OVdst, per the TI NORM examples
 * (pp. 4-121--4-122). Neither Table 2-28 nor Table 6-18 lists
 * NORM, so the row stays UNRESOLVED like ABS above. */
TI_C54X_OPCODE_MASKED(NORM_ACC, norm_acc, 0xF48F, 0xFCFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS_T_REGISTER_STATUS_SXM_OVM)
/* Syntax-1 two-word accumulate of Smem times a PROGRAM-memory
 * coefficient into the S-selected accumulator with read-phase Smem
 * T load. S/I/addr7 ride word 0 through the new
 * destination/indirect/addr7/pmad16 layout with the verbatim pmad
 * second word; the row is UNRESOLVED repeatability by the two-word
 * STM precedent. */
