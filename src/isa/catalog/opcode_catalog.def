/* Syntax-3 MPY Smem,#lk: (Smem) x lk into the D-selected accumulator
 * over the 0x6200|D<<8 base plus lk extension word, with the Smem
 * read loading T in the read phase. TI pins no R bit in this
 * space, so the unrounded leaf covers it fully; Table 6-18 omits
 * every MPY form, so the row is repeatable. */
TI_C54X_OPCODE_MASKED(MPY_SMEM_LK, mpy_smem_lk, 0x6200, 0xFE00, 2, TI_C54X_OPERAND_LAYOUT_DESTINATION_INDIRECT_ADDR7_EXTENSION16, TI_C54X_REPEATABILITY_ELIGIBLE, TI_C54X_INPUT_RESOURCES_STATUS_FRCT_OVM)
/* Syntax-4 MPY #lk: (T) x lk into the D-selected accumulator over
