TI_C54X_OPCODE_MASKED(BACCD, baccd, 0xF6E2, 0xFEFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE, TI_C54X_REPEATABILITY_INELIGIBLE, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
