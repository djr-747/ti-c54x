TI_C54X_OPCODE_MASKED(LD_IMMEDIATE_ARP, ld_immediate_arp, 0xF4A0, 0xFFF8, 1, TI_C54X_OPERAND_LAYOUT_LD_IMMEDIATE_ARP, TI_C54X_REPEATABILITY_INELIGIBLE, TI_C54X_INPUT_RESOURCES_NONE)
TI_C54X_OPCODE_MASKED(LD_SMEM_MOD2, ld_smem, 0x1090, 0xFEF8, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_ARF, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_STATUS_SXM)
TI_C54X_OPCODE_MASKED(LD_SMEM_TS_MOD2, ld_smem_ts, 0x1490, 0xFEF8, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_ARF, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_STATUS_SXM_T_REGISTER)
TI_C54X_OPCODE_MASKED(STL_SMEM_MOD2, stl_smem, 0x8090, 0xFEF8, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_ARF, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(MAX_ACC, max_acc, 0xF486, 0xFEFF, 1, TI_C54X_OPERAND_LAYOUT_MAX_MIN_ACC, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(MIN_ACC, min_acc, 0xF487, 0xFEFF, 1, TI_C54X_OPERAND_LAYOUT_MAX_MIN_ACC, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(EXP_ACC, exp_acc, 0xF48E, 0xFEFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
TI_C54X_OPCODE_MASKED(CMPL_ACC, cmpl_acc, 0xF493, 0xFCFF, 1, TI_C54X_OPERAND_LAYOUT_ACCUMULATOR_SOURCE_DESTINATION, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_ACCUMULATORS)
