/* P3-S56 MVDM Smem,MMRx (TI SPRU172C MVDM): word 0 pins 0x7200
 * with the 5-bit MMR destination at bits 4:0 (0x00-0x1F CPU
 * MMRs); word 1 carries the absolute 16-bit DATA Smem address.
 * First words with bits 7:6 set (e.g. 0x72C2) stay undecoded. */
TI_C54X_OPCODE_MASKED(MVDM, mvdm, 0x7200, 0xFFE0, 2, TI_C54X_OPERAND_LAYOUT_MMR5_ABSOLUTE16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_NONE)
/* P3-S58 MVMD MMRx,Smem (TI SPRU172C MVMD): word 0 pins 0x7300
 * with the 5-bit MMR source at bits 4:0 (0x00-0x1F CPU MMRs);
 * word 1 carries the absolute 16-bit DATA Smem address. The
 * direction-neutral MMR5_ABSOLUTE16 layout is shared with MVDM.
 * First words with bits 7:6 set stay undecoded. */
TI_C54X_OPCODE_MASKED(MVMD, mvmd, 0x7300, 0xFFE0, 2, TI_C54X_OPERAND_LAYOUT_MMR5_ABSOLUTE16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_NONE)
/* P3-S59 MVMM MMRx,MMRy (TI SPRU172C MVMM p. 4-116): word 0 pins
 * 0xE700 with the 4-bit MMR source at bits 7:4 and the 4-bit MMR
 * destination at bits 3:0. Only codes 0-8 (AR0-AR7, SP) are
 * legal per operand; the leaf rejects codes 9-15. Table 2-28
 * lists MVMM as nonrepeatable. */
TI_C54X_OPCODE_MASKED(MVMM, mvmm, 0xE700, 0xFF00, 1, TI_C54X_OPERAND_LAYOUT_MMR4_MMR4, TI_C54X_REPEATABILITY_INELIGIBLE, TI_C54X_INPUT_RESOURCES_NONE)
/* P3-S60 MVDK Smem,dmad (TI SPRU172C MVDK p. 4-107): word 0 pins
 * 0x7100 with the Smem cookie at bits 6:0 (I at bit 7); word 1
 * carries the absolute 16-bit dmad. The direct row (I=0) reads
 * DP-relative with STATUS_DP; the Smem row (I=1) reads
 * standard-indirect MOD0--MOD3 with AUXILIARY_REGISTERS. The
 * direction-neutral INDIRECT_ADDR7_EXTENSION16 layout is shared
 * with ST_LK_SMEM. Absolute/long-offset Smem stays undecoded. */
TI_C54X_OPCODE_MASKED(MVDK_DIRECT, mvdk_direct, 0x7100, 0xFF80, 2, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7_EXTENSION16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_STATUS_DP)
TI_C54X_OPCODE_MASKED(MVDK_SMEM, mvdk_smem, 0x7180, 0xFF80, 2, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7_EXTENSION16, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_AUXILIARY_REGISTERS)
/* P3-S52a PSHD Smem (TI SPRU172C 4-131): word 0 pins 0x4B with the I
 * flag at bit 7 and the 7-bit Smem cookie at bits 6:0. Direct
 * (I=0) reads page-0 dma; indirect (I=1, class 16B) reads MOD0--MOD2
 * Smem with MOD3 rejected (write-only DATA-leg rule). The Smem DATA
 * leg is read first and the observed word is written to the TOS DATA
 * WORD16. Table 2-28 lists no PSHD restriction, so repeatability
 * stays UNRESOLVED. */
TI_C54X_OPCODE_MASKED(PSHD_DIRECT, pshd_direct, 0x4B00, 0xFF00, 1, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_STACK_POINTER)
/* P3-S52a POPD Smem (TI SPRU172C 4-127): word 0 pins 0x8B with the I
 * flag at bit 7 and the 7-bit Smem cookie at bits 6:0. Direct
 * (I=0) writes page-0 dma; indirect (I=1, class 17B) writes MOD0--MOD3
 * Smem. The TOS DATA WORD16 is read first and the observed word is
 * written to the Smem DATA leg. Table 2-28 lists no POPD restriction,
 * so repeatability stays UNRESOLVED. */
TI_C54X_OPCODE_MASKED(POPD_DIRECT, popd_direct, 0x8B00, 0xFF00, 1, TI_C54X_OPERAND_LAYOUT_INDIRECT_ADDR7, TI_C54X_REPEATABILITY_UNRESOLVED, TI_C54X_INPUT_RESOURCES_STACK_POINTER)
/* P3-S52a PSHM MMR (TI SPRU172C 4-132): word 0 pins 0x4A with the I
 * flag at bit 7 and the 7-bit MMR cookie at bits 6:0. Class 16A
 * lists no indirect MMR form, so I=1 stays claimed-but-rejected
 * in the leaf; the cookie must name an MMR (below 0x20) and the
 * MMR DATA leg is read first with the observed word written to
 * the TOS DATA WORD16. Table 2-28 lists no PSHM restriction, so
 * repeatability stays UNRESOLVED. */
